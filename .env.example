# ============================================================
# marketplace-api - Variables de entorno (plantilla)
# ------------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores para tu máquina:
#   cp .env.example .env
# NUNCA subas ".env" a Git (ya está en .gitignore).
# ============================================================

# --- Proyecto ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Base de datos PostgreSQL ---
# Puerto 5433 en el host para no chocar con tu PostgreSQL local (que usa el 5432).
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5433/marketplace

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (orígenes permitidos, en formato JSON) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Seguridad / JWT ---
# Genera una clave fuerte con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Comisión de la plataforma (por defecto global) ---
DEFAULT_COMMISSION_RATE=10.00

# --- Almacenamiento de objetos (MinIO / S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=marketplace
S3_REGION=us-east-1

# --- Monedas y localización ---
DEFAULT_CURRENCY=COP
DEFAULT_LANGUAGE=es
DEFAULT_TIMEZONE=America/Bogota
# API de tasas de cambio (por defecto una API pública sin clave para desarrollo).
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_SECONDS=3600

# --- Pagos (sandbox + webhooks firmados con HMAC-SHA256) ---
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_CHECKOUT_BASE_URL=https://sandbox.marketplace.local/checkout

# --- Pagos: Mercado Pago (pasarela principal; en desarrollo se usa el sandbox de arriba) ---
# Las credenciales se crean en el panel de desarrolladores de Mercado Pago (ver la decisión 0019).
# Van vacías a propósito: sin token, `PAYMENT_PROVIDER=mercadopago` responde 503 con
# `payment_provider_not_configured` en lugar de intentar cobrar.
API_PUBLIC_URL=http://localhost:8000
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# Monto que se envía al proveedor: "integer" (sin centavos, como se usa el COP) o "decimal".
MERCADOPAGO_AMOUNT_MODE=integer

# --- Notificaciones y correos ---
# Remitente de email: "logging" (por defecto: el correo queda en el log de la API), "smtp"
# (envío real; en desarrollo apunta a Mailpit, ver más abajo) o "capturing"/"failing" (pruebas).
EMAIL_SENDER=logging
EMAIL_FROM=no-reply@marketplace.local
# Servidor SMTP. En desarrollo, Mailpit del docker-compose: interfaz web en http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Con Mailpit (o cualquier servidor sin autenticación) se dejan vacíos y no se intenta autenticar.
SMTP_USER=
SMTP_PASSWORD=
# TLS directo (conexión cifrada desde el principio: puerto 465). Con STARTTLS (587) se deja en false.
SMTP_USE_TLS=false
# Remitente del sobre SMTP: si está vacío se usa EMAIL_FROM.
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
# URL pública del frontend: con ella se construyen los enlaces de los correos
# (http://localhost:3000/es/verify-email?token=... y .../reset-password?token=...).
FRONTEND_URL=http://localhost:3000

# Worker de correos dentro del proceso de la API: true en desarrollo (los correos salen solos hacia
# Mailpit cada pocos segundos) y false en producción, donde el worker es un proceso aparte.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_SECONDS=5

# Exigir el correo verificado para vender (crear la tienda y gestionar productos) y para publicar
# preguntas y reseñas. **Apagado por defecto**: el prototipo envía el correo de verificación igual y
# el usuario puede canjearlo, pero nada queda bloqueado. Ponlo en true para exigirlo.
REQUIRE_VERIFIED_EMAIL=false

# --- Pasarelas de pago (se configuran en la Fase 7, modo sandbox) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- API de tasas de cambio (se configura en la Fase 4: Monedas) ---
EXCHANGE_RATE_API_KEY=
